# URL of the Flask backend in this same repo (see ../app.py). Point this
# at that service's deployed Railway URL once both are live, e.g.
# https://africatalking-backend.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3000

# Password for the /login page's admin gate. This is a client-side-only
# check (see ../README.md's security note) -- good enough to keep casual
# visitors off /admin, not real auth.
NEXT_PUBLIC_ADMIN_PASSWORD=admin123
